// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "django-sstq Development",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/uv": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker": {
			"version": "latest",
			"moby": false
		},
		"ghcr.io/dhoeric/features/act": {},
		"ghcr.io/devcontainers/features/git": {
			"version": "latest"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"charliermarsh.ruff",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.pyright",
				"njpwerner.autodocstring",
				"trond-snekvik.simple-rst",
				"ritwickdey.LiveServer",
				"github.vscode-github-actions",
				"SanjulaGanepola.github-local-actions",
				"redhat.vscode-yaml",
				"tamasfe.even-better-toml",
				"pre-commit-ci.pre-commit"
			],
			"settings": {
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.organizeImports": "explicit"
					}
				},
				"python.linting.enabled": true,
				"python.linting.pylintEnabled": false,
				"python.linting.flake8Enabled": false,
				"python.analysis.typeCheckingMode": "strict",
				"python.analysis.diagnosticMode": "workspace",
				"[toml]": {
					"editor.defaultFormatter": "tamasfe.even-better-toml",
					"editor.formatOnSave": true
				},
				"[yaml]": {
					"editor.defaultFormatter": "redhat.vscode-yaml",
					"editor.formatOnSave": true
				}
			}
		}
	},
	"mounts": [
		"source=${localWorkspaceFolder}/.devcontainer/.bash_aliases,target=/home/vscode/.bash_aliases,type=bind,consistency=cached",
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	],
	"remoteEnv": {
		"WORKSPACE": "${containerWorkspaceFolder}",
		"MANAGE_PY_PATH": "${containerWorkspaceFolder}/manage.py",
		"PYTHONDONTWRITEBYTECODE": "1",
		"PYTHONUNBUFFERED": "1"
	},
	"postCreateCommand": "uv sync --all-groups && pre-commit install",
	"updateContentCommand": "uv sync --all-groups && pre-commit install",
	"portsAttributes": {
		"8000": {
			"label": "Django Dev Server",
			"onAutoForward": "notify"
		}
	}
}